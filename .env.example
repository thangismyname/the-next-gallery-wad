# ==========================================================
# The Next Gallery — example environment file
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env lives at the project root and is SHARED by the backend,
# the frontend and the ai-service (each reads it at a different level).
#
# Legend (see the annotation above each variable):
#   [REQUIRED]      must be set for the app to work
#   [SECRET]        sensitive — never commit a real value; use a strong one in production
#   [OPTIONAL]      leave blank to disable the feature
#   [DEFAULT OK]    the value below works out of the box for local dev
# ==========================================================

# ── App / Vite ───────────────────────────────
# [DEFAULT OK] backend HTTP port
PORT=3000
# [REQUIRED] base URL the frontend uses to call the backend API
VITE_API_URL=http://localhost:3000/api
# [OPTIONAL] fallback used only if VITE_API_URL is missing
# VITE_API_BASE_URL=http://localhost:3000/api

# ── MinIO (S3-compatible object storage) ─────
# [DEFAULT OK] native dev: endpoint 127.0.0.1, port 9002 (host mapping of the
# next_gallery_minio container). Inside Docker (--profile full) these are overridden.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9002
# [SECRET] MinIO access key — change in production
MINIO_ACCESS_KEY=minioadmin
# [SECRET] MinIO secret key — change in production
MINIO_SECRET_KEY=minioadmin
# [REQUIRED] bucket name (lowercase letters and hyphens only; auto-created on start)
MINIO_BUCKET=the-next-gallery
MINIO_SECURE=false
MINIO_PUBLIC_BUCKET=true
MINIO_PRESIGNED_URL_EXPIRY_HOURS=24

# ── PostgreSQL 16 + pgvector ─────────────────
# [DEFAULT OK] native dev: localhost:5433 (host mapping of 5432 in the container).
# Inside the Docker network (--profile full) the backend uses DB_HOST=postgres and
# DB_PORT=5432 (set by compose, not by this file).
DB_HOST=localhost
DB_PORT=5433
# [REQUIRED] database name (created automatically by the Postgres container)
DB_NAME=the_next_gallery_db
# [REQUIRED] database user
DB_USER=postgres
# [SECRET] database password — change in production
DB_PASSWORD=postgres
DB_POOL_SIZE=5

# ── Better Auth ──────────────────────────────
# [REQUIRED][SECRET] signing secret — generate one with: openssl rand -base64 32
#   production refuses to start with this placeholder or a secret < 32 chars
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
# [REQUIRED] public base URL of the backend (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000
# [REQUIRED] comma-separated origins allowed to call the API with cookies
#   (also checked on the WebSocket handshake). Required in production — the
#   backend refuses to start without it. Empty in dev = allow any origin.
CORS_ORIGINS=http://localhost:5173
# [OPTIONAL] origins Better Auth trusts for sign-in redirects / CSRF (default = CORS_ORIGINS)
TRUSTED_ORIGINS=http://localhost:5173

# ── AI Service (ai-service FastAPI) ──────────
# [DEFAULT OK] the backend calls ai-service through this URL (native dev uses localhost).
AI_SERVICE_URL=http://localhost:8000
AI_PORT=8000
AI_HOST=0.0.0.0
# [SET YOURS] dataset folder for ai-service/pipeline + bench, outside the repo.
# Results are written to <this folder>/result-<dataset> (e.g. result-coco).
TNG_DATASETS=~/datasets

# Semantic search (OpenCLIP).
# [DEFAULT OK] stub = run the skeleton without torch; open_clip = needs torch
AI_EMBED_PROVIDER=stub
AI_CLIP_MODEL=ViT-B-32
AI_CLIP_PRETRAINED=laion2b_s34b_b79k
AI_CLIP_DEVICE=auto
# Minimum cosine threshold when searching images (0 = disable filtering)
AI_CLIP_MIN_SIM=0.22
# CLIP đa ngôn ngữ (hiểu tiếng Việt/Nhật): AI_CLIP_MODEL=xlm-roberta-base-ViT-B-32
# + AI_CLIP_PRETRAINED=laion5b_s13b_b90k → restart ai-service rồi embed lại ảnh
# (Cài đặt → Xử lý AI); probe gắn tag cần train lại bằng BENCH_CLIP (bench/README.md 6b).
# Search kết hợp (Spotlight): điểm tối thiểu 0–1 để trả ảnh về.
AI_SEARCH_MIN_SCORE=0.5
# URL ảnh/video có chữ ký: hạn theo khung giờ (24 → URL dùng được 24–48h).
# MEDIA_URL_SECRET bỏ trống → dùng BETTER_AUTH_SECRET.
MEDIA_URL_TTL_HOURS=24
MEDIA_URL_SECRET=
# Gắn tag nội dung: thư mục model .npz (tương đối ai-service/) + cấu hình (lp_clip | zs_clip).
AI_TAG_MODELS_DIR=bench/runs/cls
AI_TAG_CONFIG=lp_clip
# Timeout (ms) for every backend → ai-service request (embed + detect)
AI_TIMEOUT_MS=15000

# Object detection (YOLO26).
# [DEFAULT OK] stub = off; yolo = needs ultralytics + weights
AI_OBJECT_PROVIDER=stub
# Local: download first with `python scripts/download_yolo_weight.py` (→ ai-service/models/).
# Docker overrides this with /opt/yolo-cache/<model>. Sizes: yolo26n/s/m/l/x.pt
AI_YOLO_WEIGHTS=models/yolo26n.pt
# auto = cuda > mps (Apple Silicon) > cpu; force cpu/mps to compare devices
AI_YOLO_DEVICE=auto
AI_YOLO_CONF=0.25
AI_YOLO_IMGSZ=640
# Minimum confidence threshold when the backend searches by object
AI_YOLO_MIN_CONF=0.4

# Image similarity (DINOv3 — "Similar photos" in the Lightbox).
# [DEFAULT OK] stub = off (random vectors, no matches); dinov3 = needs weights.
# Weights are GATED on Hugging Face: accept the license, `uv run hf auth login`,
# then `uv run python scripts/download_dino_weight.py` (→ ai-service/models/).
AI_SIMILARITY_PROVIDER=stub
# Local path (relative to ai-service/) or HF repo id. Backend column is vector(384)
# → keep a 384-dim model (ViT-S/16 or ViT-S+/16).
AI_DINO_MODEL=models/dinov3-vits16-pretrain-lvd1689m
AI_DINO_DEVICE=auto
# Minimum cosine for "similar" (backend). 0 = no threshold
AI_DINO_MIN_SIM=0.35

# ── SMTP (nodemailer — password reset email) ─
# [OPTIONAL] leave SMTP_USER / SMTP_PASS blank to disable password-reset emails.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
# [OPTIONAL] SMTP username (e.g. your Mailtrap sandbox user)
SMTP_USER=
# [SECRET][OPTIONAL] SMTP password
SMTP_PASS=
SMTP_FROM="The Next Gallery <no-reply@thenextgallery.local>"

# ── OAuth (optional — leave blank to disable) ─
# [OPTIONAL] Google sign-in
GOOGLE_CLIENT_ID=
# [SECRET][OPTIONAL] Google sign-in
GOOGLE_CLIENT_SECRET=
# [OPTIONAL] GitHub sign-in
GITHUB_CLIENT_ID=
# [SECRET][OPTIONAL] GitHub sign-in
GITHUB_CLIENT_SECRET=
# [OPTIONAL] reserved — Discord is not wired up yet
DISCORD_CLIENT_ID=
# [SECRET][OPTIONAL] reserved — Discord is not wired up yet
DISCORD_CLIENT_SECRET=

# ── Production (only used with docker-compose.prod.yml) ─
# [REQUIRED for prod] public HTTPS URLs of your deployment
# PUBLIC_API_BASE_URL=https://your-domain/api
# PUBLIC_API_BASE_URL_ROOT=https://your-domain
