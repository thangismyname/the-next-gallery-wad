# ── Env / secrets ─────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ── Node ──────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── Build output ──────────────
dist/
dist-ssr/
build/
.expo/
apps/mobile/.expo/

# ── Python / ai-service ───────
ai-service/.venv/
ai-service/**/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Fonts (kept local only — proprietary/3rd-party binaries) ──
frontend/src/assets/fonts/*
!frontend/src/assets/fonts/README.md
# DFVN Basteleur (heading) — SIL OFL, được phép phân phối lại → commit để deploy có font
!frontend/src/assets/fonts/DFVN-Basteleur-*.woff2
!frontend/src/assets/fonts/Zen*.woff2
!frontend/src/assets/fonts/OFL-Zen.txt

# ── Graphify (generated knowledge graph) ──
graphify-out/

# ── OS / IDE ──────────────────
.DS_Store
.DS_Store?
._*
.vscode/
.idea/

# ── Thesis datasets (database/datasets) — xem ai-service/experiments/README.md ──
# Nặng / tải lại được → ignore. Kết quả nhẹ (Results/, History/), subset đã chọn và
# nhãn chấm tay → commit.
database/datasets/Data/
database/datasets/Classes/*
!database/datasets/Classes/open-images/
database/datasets/Classes/open-images/*
!database/datasets/Classes/open-images/subset/
!database/datasets/Classes/open-images/judgments.csv
!database/datasets/Classes/gallery-gt/
!database/datasets/Results/oi/build/
database/datasets/Results/cache/
database/datasets/Results/**/artifacts/*.npz
# Weights Ultralytics của yolo_ft (best/last.pt, 5–26 MB) — bản dùng được đã chép sang ai-service/models/ (ignore)
database/datasets/Results/**/*.pt
database/datasets/Results/**/events.jsonl
database/datasets/Results/*.log
database/datasets/Results/oi/*.log
database/datasets/Results/oi/*/*-smoke/
database/datasets/Results/oi/*/latest_smoke.json
database/datasets/Results/pipeline/**/*.npy
database/datasets/Results/pipeline/**/vis/
database/datasets/**/judge.html
database/datasets/**/.DS_Store
