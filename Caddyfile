# ==========================================================
# Caddyfile — Production Reverse Proxy cho The Next Gallery
# ==========================================================

{
    # Tắt auto-https khi test local / HTTP; bật khi cấu hình domain production
    # auto_https off
}

:80 {
    encode zstd gzip

    # ai-service KHÔNG mở ra ngoài (không có auth) — chỉ backend gọi qua mạng
    # nội bộ Docker (AI_SERVICE_URL=http://ai-service:8000).

    # Định tuyến API requests sang Backend Express
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Định tuyến toàn bộ static & SPA routes sang Frontend Nginx
    handle {
        reverse_proxy frontend:80
    }
}
