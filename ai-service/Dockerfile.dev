FROM python:3.12-slim

# uv — cài dependency đúng theo uv.lock (giống hệt máy dev, mọi thành viên).
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

WORKDIR /app

# venv nằm ngoài /app: docker-compose dev mount source vào /app sẽ không ghi đè.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

# OpenCV (ultralytics) cần lib system
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Dependency theo uv.lock (gồm group dev để chạy pytest trong container).
# torch/torchvision trên Linux lấy CPU wheel (cấu hình trong pyproject.toml).
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache

COPY . .

# OpenCLIP weights (semantic search) — tải sẵn lúc build để container chạy
# không cần internet. Set HOME để OpenCLIP tìm cache đúng chỗ.
ARG CLIP_MODEL=ViT-B-32
ARG CLIP_PRETRAINED=laion2b_s34b_b79k
ENV HOME=/opt/clip-cache
RUN python scripts/download_clip_weight.py \
    --model "$CLIP_MODEL" \
    --pretrained "$CLIP_PRETRAINED" \
    --dir /opt/clip-cache

# YOLO26 weights (object detection) — bake sẵn, runtime không cần internet.
ARG YOLO_MODEL=yolo26n.pt
RUN python scripts/download_yolo_weight.py \
    --model "$YOLO_MODEL" \
    --dir /opt/yolo-cache

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]