# Copy to apps/mobile/.env (git-ignored — the IP is per machine).
# Backend API. iOS simulator: localhost works. Real device / Android emulator: use the
# Mac's LAN IP (`ipconfig getifaddr en0`), and the phone must be on the same Wi-Fi.
# In dev a local/LAN host here is replaced by the Metro host automatically (IP changes are fine).
EXPO_PUBLIC_API_URL=http://192.168.1.30:3000/api
# Web app origin — the password-reset email links to <WEB_URL>/reset-password.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
