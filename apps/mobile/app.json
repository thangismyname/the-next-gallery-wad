{
  "expo": {
    "name": "The Next Gallery",
    "slug": "the-next-gallery",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tng",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thangismyname.thenextgallery"
    },
    "android": {
      "package": "com.thangismyname.thenextgallery",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "The Next Gallery needs access to your photos to save pictures and videos.",
          "savePhotosPermission": "The Next Gallery saves photos and videos you download to your library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The Next Gallery uses the camera to take photos and videos and upload them to your library.",
          "microphonePermission": "The Next Gallery records sound with your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Next Gallery lets you pick photos and videos to upload to your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
